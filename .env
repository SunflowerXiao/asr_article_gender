# ──────────────────────────────────────────────────────────────
# 环境变量配置模板
# 使用说明：
#   复制本文件为 .env，填入真实值，并确保 .env 已加入 .gitignore
#   示例：cp .env.example .env
# ──────────────────────────────────────────────────────────────

# 豆包大模型 API Key（从火山引擎控制台获取，同时用于 Embedding）
ARK_API_KEY=xx

# 接口鉴权 Token（自定义强随机字符串，建议 32 位以上）
# 生成示例：python -c "import secrets; print(secrets.token_hex(32))"
API_AUTH_TOKEN=a47dbb0d3420b8fd0d733dd0055ff00f256a5e4f916ab1000dc2c3906a80af37

# Flask 调试模式（生产环境必须设为 false 或不设置）
# 本地开发可设为 true，上线前务必改回 false
FLASK_DEBUG=false

# ── Token 消耗告警阈值（可选，有默认值）────────────────────────
# 单次调用 token 上限（默认 5000）
# SINGLE_CALL_TOKEN_LIMIT=5000
# 每日累计 token 上限（默认 50000）
# DAILY_TOKEN_LIMIT=50000
# 每日费用上限，单位：元（默认 10.0）
# DAILY_COST_LIMIT=10.0

# ── 火山引擎 ASR（语音识别）配置 ─────────────────────────────────
# 从火山引擎 ASR 控制台获取
ASR_APP_ID=ss
ASR_ACCESS_TOKEN=ss
# 集群名称，默认值通常无需修改
ASR_CLUSTER=ss

# ── 安装依赖说明 ──────────────────────────────────────────────
# 基础依赖（原有）：
#   pip install flask flask-cors python-dotenv 
#   pip install volcengine-python-sdk
#
# 资料库新增依赖：
#   pip install chromadb openai beautifulsoup4 requests
#
# 语音 ASR 新增依赖：
#   pip install flask-sock websockets
#
# 音频格式转换（WebM/Opus → PCM）新增依赖：
#   pip install pydub
#   同时需要系统安装 ffmpeg：apt-get install ffmpeg 或 brew install ffmpeg
#
# 或一次性安装全部：
#   pip install flask flask-cors python-dotenv volcengine-python-sdk chromadb openai beautifulsoup4 requests flask-sock websockets pydub
